# Required only for the OpenAI Responses research brain.
# Never commit a populated .env file.
OPENAI_API_KEY=

# Required only when dispatching experiments to Kaggle.
KAGGLE_API_TOKEN=
# Optional when the Kaggle client is installed outside the active Python environment.
KAGGLE_PYTHONPATH=

# Optional: local OpenAI-compatible endpoint credential.
RESEARCH_AGENT_API_KEY=local

# Path to the immutable artifact produced by Notebook 01.
KUAI_BASELINE_ARTIFACT=artifacts/iteration_000_baseline_artifacts.zip
