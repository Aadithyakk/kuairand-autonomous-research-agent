# Use a newly rotated key. Never commit the real value.
OPENAI_API_KEY=

# OpenAI Responses API researcher
KUAILAB_MODEL=gpt-5.6-sol
KUAILAB_REASONING_EFFORT=high
KUAILAB_ACADEMIC_SEARCH=true

# Official campaign limits
KUAILAB_MAX_ITERATIONS=50
KUAILAB_MAX_HOURS=6
KUAILAB_CONVERGENCE_EPSILON=0.002
KUAILAB_CONVERGENCE_PATIENCE=3

# Required only for real KuaiRand mode
KUAIRAND_DATA_PATH=
KUAI_EXPERIMENT_COMMAND=
