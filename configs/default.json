{
  "benchmark": "KuaiRand-Pure",
  "label": "long_view",
  "metrics": ["GAUC", "nDCG@5"],
  "primary_metric": "primary",
  "max_experiments": 12,
  "budget_seconds": 10800,
  "convergence_epsilon": 0.002,
  "convergence_patience": 3,
  "convergence_min_valid_experiments": 3,
  "convergence_required_families": [],
  "search": {
    "enabled": true,
    "strategy": "multi_fidelity_successive_halving",
    "reduction_factor": 3,
    "min_proxy_gain": -0.003,
    "rungs": [
      {"id": "smoke", "label": "Smoke screen", "train_fraction": 0.08, "validation_fraction": 0.20, "seeds": 1, "max_seconds": 90},
      {"id": "screen", "label": "Directional screen", "train_fraction": 0.35, "validation_fraction": 0.50, "seeds": 1, "max_seconds": 240},
      {"id": "confirm", "label": "Full confirmation", "train_fraction": 1.0, "validation_fraction": 1.0, "seeds": 3, "max_seconds": 900}
    ]
  },
  "executor_mode": "kaggle_autonomous",
  "random_seed": 2026,
  "campaign": {
    "kaggle_username": "aadithyakumar",
    "dataset_source": "arashnic/an-unbiased-sequential-recommendation-dataset",
    "kaggle_poll_seconds": 60,
    "generation_root": "runtime/openai-campaign",
    "kernel_root": "runtime/kaggle-campaign",
    "memory": "runtime/openai-pilot/memory.json",
    "candidate_attempts_per_iteration": 3,
    "max_implementation_failures": 12
  },
  "compute_profiles": [
    {
      "id": "kaggle-cpu",
      "label": "Kaggle CPU",
      "accelerator": "Remote CPU worker",
      "enabled": true,
      "recommended": true
    },
    {
      "id": "kaggle-t4",
      "label": "Kaggle T4",
      "accelerator": "NVIDIA Tesla T4 · 16 GB",
      "enabled": true,
      "recommended": false
    },
    {
      "id": "kaggle-t4-highmem",
      "label": "Kaggle T4 High Memory",
      "accelerator": "NVIDIA Tesla T4 · high-memory host",
      "enabled": true,
      "recommended": false
    }
  ],
  "llm": {
    "mode": "openai_responses",
    "base_url": "https://api.openai.com/v1",
    "model": "gpt-5.6-sol",
    "api_key_env": "OPENAI_API_KEY",
    "reasoning_effort": "medium",
    "max_output_tokens": 8000,
    "timeout_seconds": 240
  },
  "paths": {
    "state": "runtime/state.json",
    "events": "runtime/events.jsonl",
    "literature": "knowledge/literature.json",
    "actions": "knowledge/actions.json",
    "baseline_artifact": "artifacts/iteration_000_baseline_artifacts.zip",
    "workspace": "runtime/experiments"
  }
}
