{
  "benchmark": "KuaiRand-Pure",
  "label": "long_view",
  "metrics": ["GAUC", "nDCG@5"],
  "primary_metric": "primary",
  "max_experiments": 10,
  "budget_seconds": 10800,
  "convergence_epsilon": 0.002,
  "convergence_patience": 3,
  "executor_mode": "simulation",
  "random_seed": 2026,
  "llm": {
    "mode": "fallback",
    "base_url": "http://127.0.0.1:8000/v1",
    "model": "Qwen/Qwen2.5-Coder-7B-Instruct",
    "api_key_env": "RESEARCH_AGENT_API_KEY",
    "temperature": 0.35,
    "timeout_seconds": 90
  },
  "paths": {
    "state": "runtime/state.json",
    "events": "runtime/events.jsonl",
    "literature": "knowledge/literature.json",
    "actions": "knowledge/actions.json",
    "baseline_artifact": "artifacts/iteration_000_baseline_artifacts.zip",
    "workspace": "runtime/experiments"
  }
}
